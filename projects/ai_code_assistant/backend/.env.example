# 服务器配置
NODE_ENV=development
PORT=3000

# 数据库配置
MONGODB_URI=mongodb://localhost:27017/ai-code-assistant
# MONGODB_URI_PRODUCTION=mongodb+srv://username:password@cluster.mongodb.net/ai-code-assistant

# JWT 配置
JWT_SECRET=your-secret-key-change-in-production-use-uuid-or-random-string
JWT_EXPIRES_IN=7d

# Claude API 配置
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# 日志配置
LOG_LEVEL=info
